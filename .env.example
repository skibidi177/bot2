# ============================================================================
# MMO SHOP DISCORD BOT — environment configuration example
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development            # development | production | test
LOG_LEVEL=info                  # pino level: fatal error warn info debug trace
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Public base URL of this service (used for webhook URLs, OAuth redirect, admin UI)
APP_BASE_URL=https://shop.example.com

# --- Discord ---------------------------------------------------------------
# Create the application at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: guild used for guild-scoped command deployment during development
DISCORD_GUILD_ID=
# Privileged intents required in the Developer Portal:
#   - SERVER MEMBERS INTENT (welcome/autorole/verification)
#   - MESSAGE CONTENT INTENT (anti-spam, command-free flows) — optional but recommended
# OAuth2 (admin dashboard login) — Developer Portal > OAuth2 > Redirects:
#   {APP_BASE_URL}/api/admin/auth/callback
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://bot:bot@localhost:5432/bot2
# 32-byte hex key used to encrypt inventory secrets at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVENTORY_ENC_KEY=

# --- Sessions / security ---------------------------------------------------
# Secret for signing admin dashboard session cookies (min 32 chars).
SESSION_SECRET=
# Comma separated Discord user ids that are bootstrap OWNER until staff rows exist
BOOTSTRAP_OWNER_IDS=

# --- Payment provider ------------------------------------------------------
# payos  = automated verification via PayOS webhooks (requires credentials below)
# manual = self-generated VietQR to your own bank account; payments are confirmed
#          by staff with the FINANCE permission (every action audit-logged)
# mock   = TEST/STAGING ONLY. Simulates provider webhooks. Refuses to start in production.
PAYMENT_PROVIDER=manual

# PayOS credentials — https://my.payos.vn > Kênh thanh toán (payment channel)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Shared secret protecting the staging mock webhook endpoint (HMAC SHA-256).
MOCK_WEBHOOK_SECRET=

# --- Bank / VietQR (used when PAYMENT_PROVIDER=manual, and as display info) --
# Bank BIN (6 digits, e.g. 970418 = BIDV), account number and holder name
# exactly as printed on your bank paperwork / VietQR registration.
BANK_BIN=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
# Optional display-only bank label, e.g. "BIDV-CN NAM HA NOI PGD XA LA"
BANK_DISPLAY_NAME=
# Payment window for PENDING_PAYMENT orders, in minutes
ORDER_PAYMENT_TTL_MINUTES=15

# --- Operations ------------------------------------------------------------
# Allow starting without DATABASE_URL using the in-memory database.
# TEST/DEMO ONLY — data is lost on restart. Must stay false in production.
ALLOW_MEMORY_DB=false
# Low stock alert channel + sweep intervals
LOW_STOCK_CHECK_INTERVAL_MINUTES=5
ORDER_SWEEP_INTERVAL_SECONDS=30
